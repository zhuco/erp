{
  "name": "erp-workspace",
  "private": true,
  "x-entrypoint-note": "根级 package.json scripts 是官方入口；Makefile 与 scripts/accept_*.sh 仅作兼容包装层。",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "pwsh -NoProfile -File scripts/dev.ps1",
    "prepare": "pnpm run hooks:install",
    "hooks:install": "node scripts/install_git_hooks.mjs",
    "check:utf8": "node scripts/verify_utf8_encoding.mjs",
    "fix:utf8": "python scripts/normalize_utf8_encoding.py",
    "fix:utf8:staged": "python scripts/normalize_utf8_encoding.py --staged",
    "build:clean": "node scripts/clean_build_outputs.mjs",
    "build": "pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action build -Scope grid",
    "build:rebuild": "pnpm run build",
    "lint": "pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action clippy -Scope grid",
    "typecheck": "pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action check -Scope grid",
    "openapi:bundle": "node scripts/openapi_bundle.mjs",
    "test:openapi:tools": "node --test scripts/openapi/openapi_tools.test.mjs",
    "test": "pnpm run test:ui && pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action test -Scope backend",
    "accept:web": "pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action clippy -Scope grid -Platform web && pnpm run build:web",
    "accept:backend": "pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action fmt -Scope backend && pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action clippy -Scope backend && pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action test -Scope backend",
    "accept:all": "pnpm accept:backend && pnpm accept:web",
    "test:e2e": "node qa/acceptance/browser-smoke.mjs",
    "test:e2e:release-gate": "pnpm run test:e2e",
    "test:backend:release-gate": "node scripts/release_gate_backend.mjs",
    "test:ops": "node --test scripts/ops/task_ops.test.mjs scripts/ops/shared_lock_ops.test.mjs scripts/ops/subtask_retry.test.mjs",
    "ops:subtask:retry": "node scripts/ops/run_subtask_with_retry.mjs",
    "ops:task:run": "node scripts/ops/run_task_card_with_retry.mjs",
    "release:gate": "pnpm run repo:verify && pnpm run test:backend:release-gate && pnpm run accept:web && pnpm run test:e2e:release-gate",
    "release:gate:full": "pnpm run release:gate",
    "accept:p0": "pnpm run release:gate",
    "repo:verify:openapi": "pnpm run openapi:bundle && node scripts/verify_openapi_gate_v2.mjs",
    "repo:verify": "node scripts/verify_repo_baseline.mjs && pnpm run repo:verify:grid-policy && pnpm run repo:verify:openapi",
    "assess:industrial-progress": "node scripts/assess_industrial_progress.mjs",
    "build:web": "pwsh -NoProfile -File scripts/Build-ErpWeb.ps1",
    "dev:web": "node qa/acceptance/serve-web.mjs",
    "test:ui": "pwsh -NoProfile -File scripts/Invoke-ErpBuild.ps1 -Action test -Scope grid",
    "repo:verify:grid-policy": "node scripts/verify_no_ag_grid.mjs"
  },
  "devDependencies": {
    "yaml": "^2.8.3",
    "@playwright/cli": "0.1.19"
  }
}
