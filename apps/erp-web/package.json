{
  "name": "erp-web",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.node.json && tsc --noEmit --project e2e/tsconfig.json",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:perf": "playwright test e2e/order-review-performance-budget.spec.ts --project=chromium",
    "test:e2e:latency": "playwright test e2e/order-review-interaction-latency-evaluation.spec.ts --project=chromium",
    "test:e2e:release-gate": "node ./scripts/run_release_gate_e2e.mjs",
    "test:e2e:critical": "playwright test --project=chromium -g \"Critical User Paths\"",
    "generate:api": "pnpm -C ../.. run openapi:bundle && openapi-typescript ../../openapi/erp_api_v1.yaml -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.35.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "ag-grid-community": "^35.2.1",
    "ag-grid-enterprise": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "antd": "^6.2.1",
    "dayjs": "^1.11.10",
    "openapi-fetch": "^0.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-router-dom": "^6.22.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "openapi-typescript": "^6.7.5",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
