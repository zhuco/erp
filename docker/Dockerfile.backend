FROM rust:1.78-slim AS builder

WORKDIR /workspace

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates crates

RUN cargo build -p erp-api -p erp-worker -p erp-channel --release

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/release/erp-api /app/erp-api
COPY --from=builder /workspace/target/release/erp-worker /app/erp-worker
COPY --from=builder /workspace/target/release/erp-channel /app/erp-channel

ENV RUST_LOG=info

EXPOSE 8080 8081 9090

ENTRYPOINT ["/app/erp-api"]
